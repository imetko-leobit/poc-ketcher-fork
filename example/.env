SKIP_PREFLIGHT_CHECK=true
# API path served by the local Indigo REST service (matches the /v2 Flask blueprint prefix)
REACT_APP_API_PATH=/v2
PUBLIC_URL=./
GENERATE_SOURCEMAP = false

# ---------------------------------------------------------------------------
# Local Indigo integration (used when MODE=remote or MODE=local-rest)
# The Vite dev server proxies REACT_APP_API_PATH requests to LOCAL_INDIGO_URL.
# Start the local Indigo backend first (see INDIGO_INTEGRATION.md).
# ---------------------------------------------------------------------------
LOCAL_INDIGO_URL=http://localhost:8002

# ---------------------------------------------------------------------------
# Local Indigo WASM override (used when MODE=local-wasm)
# Point this to the directory containing a locally-built indigo-ketcher.js.
# Leave empty to use the vendored indigo-ketcher npm package instead.
# Example: LOCAL_INDIGO_WASM_PATH=../../poc-indigo-fork/api/wasm/indigo-ketcher/build
# ---------------------------------------------------------------------------
LOCAL_INDIGO_WASM_PATH=../../poc-indigo-fork/api/wasm/indigo-ketcher/build